    "better-npm-audit": "^3.11.0",
    "bundlesize2": "^0.0.35",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^24.0.0",
    "msw": "^2.15.0",
    "postcss": "^8.4.33",
