    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^6.30.4",
    "sonner": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.4",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.2.0",
