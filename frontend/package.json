    "better-npm-audit": "^4.2.1",
    "bundlesize2": "^0.0.35",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "postcss": "^8.5.33",
